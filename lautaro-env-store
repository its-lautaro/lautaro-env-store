#!/usr/bin/env python3
"""lautaro-env-store: guarda variables de entorno en ~/.lautaro-env y las deja listas para el shell.

Formatos aceptados:
  lautaro-env-store API_USER usuario                          # una: nombre valor
  lautaro-env-store API_USER=usuario API_PASSWORD=secreto     # una o varias: NOMBRE=valor
  lautaro-env-store API_USER="Un Usuario"                     # valores con espacios: comillas del shell
  lautaro-env-store --init                                    # solo crea el store y el source en el rc

Mantenimiento:
  lautaro-env-store --list                     # nombres guardados y fecha (nunca los valores)
  lautaro-env-store --remove API_USER          # borra esas variables
  lautaro-env-store --clear [--yes]            # borra todas
"""
import datetime as dt
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

STORE = Path(os.environ.get("LAUTARO_ENV_FILE", Path.home() / ".lautaro-env"))
RC_FILES = [Path.home() / ".zshrc", Path.home() / ".bashrc"]
SOURCE_LINE = f'[ -f "{STORE}" ] && source "{STORE}"  # lautaro-env-store'
NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
ENTRY_RE = re.compile(r"^export\s+(?P<name>[A-Za-z_][A-Za-z0-9_]*)=")
SAVED_RE = re.compile(r"# saved (\d{4}-\d{2}-\d{2} \d{2}:\d{2})$")


def usage(code=1):
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(code)


def parse(args):
    """Devuelve una lista de (nombre, valor): `NOMBRE valor` o uno o más `NOMBRE=valor`."""
    if not args:
        usage()
    if all("=" in a for a in args):
        return [tuple(a.split("=", 1)) for a in args]
    if len(args) == 2:
        return [(args[0], args[1])]
    fail(f"no pude interpretar los argumentos: {args!r}")


def fail(message):
    print(f"❌ {message}", file=sys.stderr)
    usage()


def shell_quote(value):
    return "'" + value.replace("'", "'\"'\"'") + "'"


def read_entries():
    """Lista de (nombre, fecha) en el orden del archivo; la fecha puede ser None en entradas viejas."""
    if not STORE.exists():
        return []
    entries = []
    for line in STORE.read_text().splitlines():
        m = ENTRY_RE.match(line)
        if m:
            saved = SAVED_RE.search(line)
            entries.append((m.group("name"), saved.group(1) if saved else None))
    return entries


def write_lines(lines):
    STORE.touch(mode=0o600, exist_ok=True)
    os.chmod(STORE, 0o600)
    STORE.write_text("\n".join(lines) + ("\n" if lines else ""))


def store(pairs):
    """Guarda los pares y devuelve los nombres que ya existían (se reemplazaron)."""
    existing = {name for name, _ in read_entries()}
    names = {name for name, _ in pairs}
    lines = STORE.read_text().splitlines() if STORE.exists() else []
    kept = [l for l in lines if not (ENTRY_RE.match(l) and ENTRY_RE.match(l).group("name") in names)]
    stamp = dt.datetime.now().strftime("%Y-%m-%d %H:%M")
    kept += [f"export {name}={shell_quote(value)}  # saved {stamp}" for name, value in pairs]
    write_lines(kept)
    return names & existing


def remove(names):
    """Borra las variables indicadas; devuelve las que no existían."""
    lines = STORE.read_text().splitlines() if STORE.exists() else []
    present = {name for name, _ in read_entries()}
    kept = [l for l in lines if not (ENTRY_RE.match(l) and ENTRY_RE.match(l).group("name") in names)]
    write_lines(kept)
    return set(names) - present


def cmd_list():
    entries = read_entries()
    if not entries:
        print(f"📭 No hay variables guardadas en {STORE}")
        return
    print(f"🗂  {len(entries)} variable{'s' if len(entries) > 1 else ''} en {STORE}:")
    for name, date in entries:
        print(f"   🔑 {name}" + (f"  (guardada {date})" if date else ""))
    copy_to_clipboard(" ".join(name for name, _ in entries))


def cmd_remove(names):
    if not names:
        fail("--remove necesita al menos un nombre")
    missing = remove(names)
    removed = [n for n in names if n not in missing]
    for n in removed:
        print(f"🗑  {n} eliminada")
    for n in missing:
        print(f"🤷 {n} no estaba guardada")
    if removed:
        print(f"🚀 En esta terminal además: unset {' '.join(removed)}")


def cmd_clear(args):
    entries = read_entries()
    if not entries:
        print("📭 No había nada que borrar")
        return
    if "--yes" not in args and "-y" not in args:
        answer = input(f"⚠️  Vas a borrar {len(entries)} variable(s) de {STORE}. ¿Seguro? [y/N] ").strip().lower()
        if answer not in ("y", "yes", "s", "si", "sí"):
            print("👌 Cancelado")
            return
    write_lines([])
    print(f"🧹 Store vacío. En esta terminal además: unset {' '.join(n for n, _ in entries)}")


def ensure_sourced():
    """Agrega la línea de source al rc del shell que exista (zsh primero), una sola vez."""
    for rc in RC_FILES:
        if rc.exists():
            content = rc.read_text()
            if "lautaro-env-store" in content:
                return rc, False
            with rc.open("a") as f:
                f.write(f"\n# lautaro-env-store: variables guardadas con `lautaro-env-store`\n{SOURCE_LINE}\n")
            return rc, True
    return None, False


def copy_to_clipboard(text):
    for cmd in (["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"]):
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), check=True)
                return True
            except (OSError, subprocess.CalledProcessError):
                continue
    return False


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        usage(0)
    if args and args[0] in ("--list", "ls"):
        cmd_list()
        return
    if args and args[0] in ("--remove", "rm"):
        cmd_remove(args[1:])
        return
    if args and args[0] == "--clear":
        cmd_clear(args[1:])
        return
    if args and args[0] == "--init":
        STORE.touch(mode=0o600, exist_ok=True)
        rc, added = ensure_sourced()
        print(f"🧩 Store listo en {STORE}" + (f"; agregué el source a {rc}" if added else " (el shell ya lo cargaba)"))
        return
    pairs = parse(args)
    for name, _ in pairs:
        if not NAME_RE.match(name):
            fail(f"'{name}' no es un nombre válido de variable de entorno")

    replaced = store(pairs)
    rc, added = ensure_sourced()
    names = [name for name, _ in pairs]
    copied = copy_to_clipboard(" ".join(names))

    plural = "s" if len(names) > 1 else ""
    print(f"🔐 Variable{plural} guardada{plural} en {STORE}:")
    for name in names:
        print(f"   {'♻️  ' + name + ' (reemplazada)' if name in replaced else '✅ ' + name}")
    if copied:
        print(f"📋 Nombre{plural} copiado{plural} al clipboard: {' '.join(names)}")
    else:
        print("⚠️  No encontré un comando de clipboard (pbcopy/xclip/wl-copy); los nombres quedan arriba.")
    if added:
        print(f"🧩 Agregué el source de {STORE} a {rc}")
    print(f"🚀 Para usarla{plural} en esta terminal: source {STORE}  (las nuevas terminales ya las cargan solas)")


if __name__ == "__main__":
    main()
